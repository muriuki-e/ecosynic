{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/home", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/article-image", "destination": "/api/articles?image=1" },
    { "source": "/home", "destination": "/index" }
  ]
}